{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "routes": [
    { "src": "^/$", "dest": "/api/seo?slug=home" },
    { "src": "^/index\\.html$", "dest": "/api/seo?slug=home" },
    { "src": "^/servicios/inmobiliaria\\.html$", "dest": "/api/seo?slug=inmobiliaria" },
    { "src": "^/servicios/interventoria\\.html$", "dest": "/api/seo?slug=interventoria" },
    { "src": "^/servicios/propiedad_horizontal\\.html$", "dest": "/api/seo?slug=propiedad_horizontal" },
    { "handle": "filesystem" },
    { "src": "^/admin/?$", "dest": "/admin/index.html" },
    { "src": "^/admin/login/?$", "dest": "/admin/login.html" }
  ]
}
